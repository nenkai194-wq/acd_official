# Konfigurasi Environment Produksi PT. Aksara Cipta Digital (ACD)
# Salin file ini menjadi .env atau atur langsung pada panel Environment Variables hosting / systemd

# Kunci rahasia Flask session (WAJIB diganti dengan string acak panjang di server produksi)
SECRET_KEY=ganti-dengan-random-secret-key-minimal-64-karakter-hex

# Mode debug WAJIB False di server produksi (hosting)
FLASK_DEBUG=False

# Aktifkan True jika website sudah menggunakan SSL/HTTPS (https://acd.co.id)
SESSION_COOKIE_SECURE=True

# Kredensial Administrator Default (disarankan ubah melalui menu Pengaturan Website setelah login)
ADMIN_USER=admin
ADMIN_PASS=GantiPasswordKuatAnda!2026
ADMIN_PIN=555556
